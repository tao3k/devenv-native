    <qianji:config>
      <!-- Remove stale qianji:inputs value(s): currentQuestion,currentChoices. -->
      <qianji:inputs></qianji:inputs>
      <!-- Keep the existing static qianji:interaction with qianji:question, qianji:choice, and qianji:result. -->
    </qianji:config>
  </extensionElements>
</userTask>
```

