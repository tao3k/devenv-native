<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="Definitions_comma_day_minute_window"
  name="Comma Day Minute Window DRD"
  namespace="http://example.com/dmn">
  <decision id="comma-day-minute-window" name="Comma Day Minute Window">
    <decisionTable id="decision_table_comma_day_minute_window" hitPolicy="UNIQUE">
      <input id="input_elapsed" label="elapsed">
        <inputExpression id="input_expression_elapsed" typeRef="dayTimeDuration">
          <text>elapsed</text>
        </inputExpression>
      </input>
      <output id="output_window" name="window" label="window" typeRef="string" />
      <rule id="rule_comma_minute_window">
        <inputEntry id="input_entry_comma_minute_window">
          <text>duration("PT1,5M") &lt;= ? &lt; duration("PT2,75M")</text>
        </inputEntry>
        <outputEntry id="output_entry_comma_minute_window">
          <text>"minute-window-comma"</text>
        </outputEntry>
      </rule>
      <rule id="rule_comma_day_window">
        <inputEntry id="input_entry_comma_day_window">
          <text>[duration("P1,25D")..duration("P1,5D")]</text>
        </inputEntry>
        <outputEntry id="output_entry_comma_day_window">
          <text>"day-window-comma"</text>
        </outputEntry>
      </rule>
      <rule id="rule_outside_comma_day_minute_window">
        <inputEntry id="input_entry_outside_comma_day_minute_window">
          <text>-</text>
        </inputEntry>
        <outputEntry id="output_entry_outside_comma_day_minute_window">
          <text>"outside-day-minute-window-comma"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
