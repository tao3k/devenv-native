<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="Definitions_sla_window"
  name="SLA Window DRD"
  namespace="http://example.com/dmn">
  <decision id="sla-window" name="SLA Window">
    <decisionTable id="decision_table_sla_window" hitPolicy="UNIQUE">
      <input id="input_elapsed" label="elapsed">
        <inputExpression id="input_expression_elapsed" typeRef="dayTimeDuration">
          <text>elapsed</text>
        </inputExpression>
      </input>
      <output id="output_band" name="band" label="band" typeRef="string" />
      <rule id="rule_exact_half_hour">
        <inputEntry id="input_entry_exact_half_hour">
          <text>duration("PT30M")</text>
        </inputEntry>
        <outputEntry id="output_entry_exact_half_hour">
          <text>"exact-half-hour"</text>
        </outputEntry>
      </rule>
      <rule id="rule_under_hour">
        <inputEntry id="input_entry_under_hour">
          <text>&lt; duration("PT1H")</text>
        </inputEntry>
        <outputEntry id="output_entry_under_hour">
          <text>"under-hour"</text>
        </outputEntry>
      </rule>
      <rule id="rule_hour_or_more">
        <inputEntry id="input_entry_hour_or_more">
          <text>&gt;= duration("PT1H")</text>
        </inputEntry>
        <outputEntry id="output_entry_hour_or_more">
          <text>"hour-or-more"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
