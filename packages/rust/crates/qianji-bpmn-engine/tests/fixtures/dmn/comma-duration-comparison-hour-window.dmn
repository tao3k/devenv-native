<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="Definitions_comma_hour_window"
  name="Comma Hour Window DRD"
  namespace="http://example.com/dmn">
  <decision id="comma-hour-window" name="Comma Hour Window">
    <decisionTable id="decision_table_comma_hour_window" hitPolicy="UNIQUE">
      <input id="input_elapsed" label="elapsed">
        <inputExpression id="input_expression_elapsed" typeRef="dayTimeDuration">
          <text>elapsed</text>
        </inputExpression>
      </input>
      <output id="output_band" name="band" label="band" typeRef="string" />
      <rule id="rule_exact_one_point_five_hours_comma">
        <inputEntry id="input_entry_exact_one_point_five_hours_comma">
          <text>duration("PT1,5H")</text>
        </inputEntry>
        <outputEntry id="output_entry_exact_one_point_five_hours_comma">
          <text>"exact-one-point-five-hours-comma"</text>
        </outputEntry>
      </rule>
      <rule id="rule_before_two_point_two_five_hours_comma">
        <inputEntry id="input_entry_before_two_point_two_five_hours_comma">
          <text>&lt; duration("PT2,25H")</text>
        </inputEntry>
        <outputEntry id="output_entry_before_two_point_two_five_hours_comma">
          <text>"before-two-point-two-five-hours-comma"</text>
        </outputEntry>
      </rule>
      <rule id="rule_two_point_two_five_hours_or_more_comma">
        <inputEntry id="input_entry_two_point_two_five_hours_or_more_comma">
          <text>&gt;= duration("PT2,25H")</text>
        </inputEntry>
        <outputEntry id="output_entry_two_point_two_five_hours_or_more_comma">
          <text>"two-point-two-five-hours-or-more-comma"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
