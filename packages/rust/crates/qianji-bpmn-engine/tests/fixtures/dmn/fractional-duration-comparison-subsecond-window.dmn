<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  id="Definitions_subsecond_window"
  name="Subsecond Window DRD"
  namespace="http://example.com/dmn">
  <decision id="subsecond-window" name="Subsecond Window">
    <decisionTable id="decision_table_subsecond_window" hitPolicy="UNIQUE">
      <input id="input_elapsed" label="elapsed">
        <inputExpression id="input_expression_elapsed" typeRef="dayTimeDuration">
          <text>elapsed</text>
        </inputExpression>
      </input>
      <output id="output_band" name="band" label="band" typeRef="string" />
      <rule id="rule_exact_one_point_five_seconds">
        <inputEntry id="input_entry_exact_one_point_five_seconds">
          <text>duration("PT1.5S")</text>
        </inputEntry>
        <outputEntry id="output_entry_exact_one_point_five_seconds">
          <text>"exact-one-point-five-seconds"</text>
        </outputEntry>
      </rule>
      <rule id="rule_before_two_point_two_five_seconds">
        <inputEntry id="input_entry_before_two_point_two_five_seconds">
          <text>&lt; duration("PT2.25S")</text>
        </inputEntry>
        <outputEntry id="output_entry_before_two_point_two_five_seconds">
          <text>"before-two-point-two-five-seconds"</text>
        </outputEntry>
      </rule>
      <rule id="rule_two_point_two_five_seconds_or_more">
        <inputEntry id="input_entry_two_point_two_five_seconds_or_more">
          <text>&gt;= duration("PT2.25S")</text>
        </inputEntry>
        <outputEntry id="output_entry_two_point_two_five_seconds_or_more">
          <text>"two-point-two-five-seconds-or-more"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
