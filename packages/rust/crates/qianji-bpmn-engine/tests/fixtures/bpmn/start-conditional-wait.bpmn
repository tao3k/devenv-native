<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  id="pkg_start_conditional_wait"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <bpmn:process id="start_conditional_wait">
    <bpmn:startEvent id="start">
      <bpmn:conditionalEventDefinition name="workflow_condition">
        <bpmn:condition>approved</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:endEvent id="end" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
