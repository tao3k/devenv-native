<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  id="pkg_invalid_top_level_escalation_throw"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <bpmn:process id="main_process" isExecutable="true">
    <bpmn:startEvent id="start" />
    <bpmn:intermediateThrowEvent id="escalation_throw">
      <bpmn:escalationEventDefinition escalationRef="review_escalated" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="escalation_throw" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="escalation_throw" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
