<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    id="pkg_invalid_event_gateway"
    targetNamespace="https://tao3k.dev/qianji/bpmn">
  <bpmn:process id="event_race_invalid" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>flow_start_gateway</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_start_gateway" sourceRef="start" targetRef="wait_race" />
    <bpmn:eventBasedGateway id="wait_race">
      <bpmn:incoming>flow_start_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_gateway_message</bpmn:outgoing>
      <bpmn:outgoing>flow_gateway_task</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="wait_invoice">
      <bpmn:incoming>flow_gateway_message</bpmn:incoming>
      <bpmn:outgoing>flow_message_end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="message_wait" messageRef="invoice_message" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="unexpected_service">
      <bpmn:incoming>flow_gateway_task</bpmn:incoming>
      <bpmn:outgoing>flow_task_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_gateway_message" sourceRef="wait_race" targetRef="wait_invoice" />
    <bpmn:sequenceFlow id="flow_gateway_task" sourceRef="wait_race" targetRef="unexpected_service" />
    <bpmn:endEvent id="invoice_end">
      <bpmn:incoming>flow_message_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="task_end">
      <bpmn:incoming>flow_task_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_message_end" sourceRef="wait_invoice" targetRef="invoice_end" />
    <bpmn:sequenceFlow id="flow_task_end" sourceRef="unexpected_service" targetRef="task_end" />
  </bpmn:process>
  <bpmn:message id="invoice_message" name="InvoiceReceived" />
</bpmn:definitions>
