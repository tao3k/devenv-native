<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  id="Definitions_invalid_standard_loop"
  targetNamespace="https://tao3k.dev/qianji-bpmn-engine">
  <bpmn:process id="loop_invalid" isExecutable="true">
    <bpmn:startEvent id="start" />
    <bpmn:serviceTask id="review">
      <bpmn:standardLoopCharacteristics />
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" />
    <bpmn:sequenceFlow id="flow_start_review" sourceRef="start" targetRef="review" />
    <bpmn:sequenceFlow id="flow_review_end" sourceRef="review" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
