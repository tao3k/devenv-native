<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="pkg_exclusive_gateway_numeric_conditions">
  <bpmn:process id="exclusive_gateway_numeric_conditions" isExecutable="true">
    <bpmn:startEvent id="start" />
    <bpmn:exclusiveGateway id="decision" default="flow_default" />
    <bpmn:endEvent id="high_amount_end" />
    <bpmn:endEvent id="high_risk_end" />
    <bpmn:endEvent id="default_end" />
    <bpmn:sequenceFlow id="flow_start" sourceRef="start" targetRef="decision" />
    <bpmn:sequenceFlow id="flow_high_amount" sourceRef="decision" targetRef="high_amount_end">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">amount > 100</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_high_risk" sourceRef="decision" targetRef="high_risk_end">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">risk >= 7</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_default" sourceRef="decision" targetRef="default_end" />
  </bpmn:process>
</bpmn:definitions>
