<bpmn:definitions
  id="pkg_top_level_error_end"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <bpmn:process id="root_error_process" isExecutable="true">
    <bpmn:startEvent id="start" />
    <bpmn:endEvent id="fatal_end">
