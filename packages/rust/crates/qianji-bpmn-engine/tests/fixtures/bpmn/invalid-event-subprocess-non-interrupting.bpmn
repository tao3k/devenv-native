<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  id="pkg_invalid_event_subprocess_non_interrupting"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <bpmn:process id="event_subprocess_non_interrupting">
    <bpmn:startEvent id="start" />
    <bpmn:endEvent id="end" />
    <bpmn:subProcess id="non_interrupting_event_subprocess" triggeredByEvent="true">
      <bpmn:startEvent id="event_start" isInterrupting="false">
        <bpmn:messageEventDefinition messageRef="interrupt_request" />
      </bpmn:startEvent>
      <bpmn:endEvent id="event_end" />
      <bpmn:sequenceFlow id="event_flow_1" sourceRef="event_start" targetRef="event_end" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
