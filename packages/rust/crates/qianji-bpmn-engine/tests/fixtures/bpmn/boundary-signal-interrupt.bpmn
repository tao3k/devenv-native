<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  id="pkg_boundary_signal_interrupt"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <bpmn:process id="review_with_signal_boundary">
    <bpmn:startEvent id="start" />
    <bpmn:userTask id="review" />
    <bpmn:boundaryEvent id="review_alert" attachedToRef="review" cancelActivity="true">
      <bpmn:signalEventDefinition signalRef="review_signal" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="approved_end" />
    <bpmn:endEvent id="alert_end" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="review" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="review" targetRef="approved_end" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="review_alert" targetRef="alert_end" />
  </bpmn:process>
</bpmn:definitions>
