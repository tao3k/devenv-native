                "examples": [
                  "approved",
                  "not approved",
                  "flags.approved"
                ],
                "value_type": "boolean"
              },
              "numeric_comparison": {
                "examples": [
                  "amount > 100",
                  "risk >= 7"
                ],
                "left": "identifier path",
                "operators": [
                  "==",
                  "!=",
                  ">",
                  ">=",
                  "<",
                  "<="
                ],
                "right": "finite numeric literal"
              }
            },
            "examples": [
              "approved",
              "not approved",
              "flags.approved",
              "amount > 100",
              "risk >= 7"
            ],
            "forbidden_forms": [
              "approved == true",
              "approved == false",
              "approved and vip",
              "${approved}",
              "functions",
              "scripts",
              "FEEL expressions"
            ],
            "op": "rewrite_condition_expression"
          }
        ],
