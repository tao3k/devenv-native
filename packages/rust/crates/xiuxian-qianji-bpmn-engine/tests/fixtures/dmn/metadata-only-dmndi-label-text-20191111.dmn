<?xml version="1.0" encoding="UTF-8"?>
<definitions
  id="Definitions_label_text"
  name="DMNDI label text"
  namespace="urn:test:dmn:dmndi-label-text"
  xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
  xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/">
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="diagram_label_text">
      <dmndi:DMNShape id="shape_input_1" dmnElementRef="InputData_1">
        <dmndi:DMNLabel id="shape_label_1">
          <dmndi:Text>Shape Label</dmndi:Text>
        </dmndi:DMNLabel>
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="edge_requirement_1" dmnElementRef="Requirement_1">
        <dmndi:DMNLabel id="edge_label_1">
          <dmndi:Text>Edge Label</dmndi:Text>
        </dmndi:DMNLabel>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
