<?xml version="1.0" encoding="UTF-8"?>
<definitions
  id="Definitions_missing_required_input_runtime"
  name="Missing Required Input Runtime"
  namespace="https://example.com/dmn/missing-required-input-runtime"
  xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/">
  <decision id="Decision_missing_required_input" name="Missing Required Input Decision">
    <informationRequirement>
      <requiredInput href="#InputData_missing" />
    </informationRequirement>
    <decisionTable id="DecisionTable_missing_required_input">
      <input id="InputClause_age">
        <inputExpression id="InputExpression_age" typeRef="number">
          <text>applicant.age</text>
        </inputExpression>
      </input>
      <output id="OutputClause_approval" name="approval" typeRef="string" />
      <rule id="DecisionRule_missing_required_input">
        <inputEntry id="UnaryTests_missing_required_input">
          <text>&gt;= 18</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_missing_required_input">
          <text>"approve"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
