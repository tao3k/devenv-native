<?xml version="1.0" encoding="UTF-8"?>
<definitions
  id="Definitions_knowledge_requirement"
  name="Knowledge Requirement Decision"
  namespace="https://example.com/dmn/knowledge-requirement-decision"
  xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/">
  <businessKnowledgeModel id="BKM_policy_source" name="Policy Source">
    <literalExpression id="BKM_policy_source_expression">
      <text>"external-policy"</text>
    </literalExpression>
  </businessKnowledgeModel>
  <decision id="Decision_knowledge_requirement" name="Knowledge Requirement Decision">
    <knowledgeRequirement>
      <requiredKnowledge href="#BKM_policy_source" />
    </knowledgeRequirement>
  </decision>
</definitions>
