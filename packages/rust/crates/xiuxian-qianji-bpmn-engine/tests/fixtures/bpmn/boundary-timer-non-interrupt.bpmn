<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  id="pkg_boundary_timer_non_interrupt"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <bpmn:process id="review_with_timeout">
    <bpmn:startEvent id="start" />
    <bpmn:userTask id="review" />
    <bpmn:boundaryEvent id="review_timeout" attachedToRef="review" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="approved_end" />
    <bpmn:endEvent id="timeout_end" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="review" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="review" targetRef="approved_end" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="review_timeout" targetRef="timeout_end" />
  </bpmn:process>
</bpmn:definitions>
