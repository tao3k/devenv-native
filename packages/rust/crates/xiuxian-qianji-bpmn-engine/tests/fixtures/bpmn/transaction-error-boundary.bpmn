<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  id="pkg_transaction_error_boundary"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <bpmn:process id="main_process" isExecutable="true">
    <bpmn:startEvent id="start" />
    <bpmn:transaction id="payment_tx">
      <bpmn:startEvent id="tx_start" />
      <bpmn:userTask id="tx_review" />
      <bpmn:endEvent id="tx_error_end">
        <bpmn:errorEventDefinition errorRef="payment_error" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="tx_flow_1" sourceRef="tx_start" targetRef="tx_review" />
      <bpmn:sequenceFlow id="tx_flow_2" sourceRef="tx_review" targetRef="tx_error_end" />
    </bpmn:transaction>
    <bpmn:boundaryEvent id="tx_error_boundary" attachedToRef="payment_tx" cancelActivity="true">
      <bpmn:errorEventDefinition errorRef="payment_error" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="success_end" />
    <bpmn:endEvent id="errored_end" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="payment_tx" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="payment_tx" targetRef="success_end" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="tx_error_boundary" targetRef="errored_end" />
  </bpmn:process>
</bpmn:definitions>
