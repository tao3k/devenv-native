<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  id="Definitions_invalid_multi_instance_in_place_output"
  targetNamespace="https://tao3k.dev/xiuxian-qianji-bpmn-engine">
  <bpmn:process id="multi_instance_in_place_output" isExecutable="true">
    <bpmn:startEvent id="start" />
    <bpmn:serviceTask id="review">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopDataInputRef>items</bpmn:loopDataInputRef>
        <bpmn:inputDataItem id="item" />
        <bpmn:loopDataOutputRef>items</bpmn:loopDataOutputRef>
        <bpmn:outputDataItem id="result" />
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" />
    <bpmn:sequenceFlow id="flow_start_review" sourceRef="start" targetRef="review" />
    <bpmn:sequenceFlow id="flow_review_end" sourceRef="review" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
