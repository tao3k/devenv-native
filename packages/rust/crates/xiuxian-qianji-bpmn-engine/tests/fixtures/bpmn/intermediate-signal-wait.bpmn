<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  id="pkg_event"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <bpmn:process id="await_signal">
    <bpmn:startEvent id="start" />
    <bpmn:intermediateCatchEvent id="wait_signal">
      <bpmn:signalEventDefinition signalRef="alert_signal" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="wait_signal" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="wait_signal" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
