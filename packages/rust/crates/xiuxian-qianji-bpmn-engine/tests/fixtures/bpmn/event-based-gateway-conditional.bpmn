<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    id="pkg_event_gateway_conditional"
    targetNamespace="https://tao3k.dev/bpmn">
  <bpmn:process id="event_race_conditional" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>flow_start_gateway</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_start_gateway" sourceRef="start" targetRef="wait_race" />
    <bpmn:eventBasedGateway id="wait_race">
      <bpmn:incoming>flow_start_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_gateway_message</bpmn:outgoing>
      <bpmn:outgoing>flow_gateway_condition</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="wait_invoice">
      <bpmn:incoming>flow_gateway_message</bpmn:incoming>
      <bpmn:outgoing>flow_message_end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="message_wait" messageRef="invoice_message" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="wait_approval">
      <bpmn:incoming>flow_gateway_condition</bpmn:incoming>
      <bpmn:outgoing>flow_condition_end</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="condition_wait">
        <bpmn:condition>approved</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="flow_gateway_message" sourceRef="wait_race" targetRef="wait_invoice" />
    <bpmn:sequenceFlow id="flow_gateway_condition" sourceRef="wait_race" targetRef="wait_approval" />
    <bpmn:endEvent id="invoice_end">
      <bpmn:incoming>flow_message_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="approval_end">
      <bpmn:incoming>flow_condition_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_message_end" sourceRef="wait_invoice" targetRef="invoice_end" />
    <bpmn:sequenceFlow id="flow_condition_end" sourceRef="wait_approval" targetRef="approval_end" />
  </bpmn:process>
  <bpmn:message id="invoice_message" name="InvoiceReceived" />
</bpmn:definitions>
