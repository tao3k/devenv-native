<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  id="pkg_embedded_subprocess_invalid_end"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <bpmn:process id="main_process" isExecutable="true">
    <bpmn:startEvent id="start" />
    <bpmn:subProcess id="inline_review">
      <bpmn:startEvent id="sub_start" />
      <bpmn:userTask id="sub_review" />
      <bpmn:sequenceFlow id="sub_flow_1" sourceRef="sub_start" targetRef="sub_review" />
    </bpmn:subProcess>
    <bpmn:endEvent id="end" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="inline_review" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="inline_review" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
