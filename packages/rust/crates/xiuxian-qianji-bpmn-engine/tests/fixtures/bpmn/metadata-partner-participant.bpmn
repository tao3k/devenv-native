<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  id="Definitions_PartnerParticipant"
  targetNamespace="https://example.com/bpmn/partner-participant">
  <bpmn:message id="Message_Request" name="Request" />
  <bpmn:interface id="Interface_Review" name="Review API" implementationRef="urn:review">
    <bpmn:operation id="Operation_Review" name="Review">
      <bpmn:inMessageRef>Message_Request</bpmn:inMessageRef>
    </bpmn:operation>
  </bpmn:interface>
  <bpmn:endPoint id="Endpoint_ReviewApi" />
  <bpmn:partnerEntity id="PartnerEntity_RequestNetwork" name="Request Network">
    <bpmn:participantRef>Participant_Requester</bpmn:participantRef>
    <bpmn:participantRef>Participant_Approver</bpmn:participantRef>
  </bpmn:partnerEntity>
  <bpmn:partnerRole id="PartnerRole_Approver" name="Approver">
    <bpmn:participantRef>Participant_Approver</bpmn:participantRef>
  </bpmn:partnerRole>
  <bpmn:collaboration id="Collaboration_PartnerParticipant">
    <bpmn:participant id="Participant_Requester" name="Requester" processRef="Process_Request">
      <bpmn:interfaceRef>Interface_Review</bpmn:interfaceRef>
      <bpmn:endPointRef>Endpoint_ReviewApi</bpmn:endPointRef>
      <bpmn:participantMultiplicity id="Multiplicity_Requester" minimum="1" maximum="3" />
    </bpmn:participant>
    <bpmn:participant id="Participant_Approver" name="Approver" />
    <bpmn:messageFlow id="MessageFlow_Request" sourceRef="Participant_Requester" targetRef="Participant_Approver" messageRef="Message_Request" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Request" isExecutable="true">
    <bpmn:startEvent id="Start_Request" />
    <bpmn:endEvent id="End_Request" />
    <bpmn:sequenceFlow id="Flow_Request" sourceRef="Start_Request" targetRef="End_Request" />
  </bpmn:process>
</bpmn:definitions>
