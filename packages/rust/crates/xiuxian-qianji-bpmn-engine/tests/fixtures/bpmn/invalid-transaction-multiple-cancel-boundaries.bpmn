<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  id="pkg_invalid_transaction_multiple_cancel_boundaries"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <bpmn:process id="main_process" isExecutable="true">
    <bpmn:startEvent id="start" />
    <bpmn:transaction id="payment_tx">
      <bpmn:startEvent id="tx_start" />
      <bpmn:userTask id="tx_review" />
      <bpmn:endEvent id="tx_cancel_end">
        <bpmn:cancelEventDefinition />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="tx_flow_1" sourceRef="tx_start" targetRef="tx_review" />
      <bpmn:sequenceFlow id="tx_flow_2" sourceRef="tx_review" targetRef="tx_cancel_end" />
    </bpmn:transaction>
    <bpmn:boundaryEvent id="tx_cancel_boundary_a" attachedToRef="payment_tx" cancelActivity="true">
      <bpmn:cancelEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="tx_cancel_boundary_b" attachedToRef="payment_tx" cancelActivity="true">
      <bpmn:cancelEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="success_end" />
    <bpmn:endEvent id="cancelled_end_a" />
    <bpmn:endEvent id="cancelled_end_b" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="payment_tx" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="payment_tx" targetRef="success_end" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="tx_cancel_boundary_a" targetRef="cancelled_end_a" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="tx_cancel_boundary_b" targetRef="cancelled_end_b" />
  </bpmn:process>
</bpmn:definitions>
