<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  id="Definitions_parallel_multi_instance_loop_input"
  targetNamespace="https://tao3k.dev/xiuxian-qianji-bpmn-engine">
  <bpmn:process id="multi_instance_loop_input_parallel" isExecutable="true">
    <bpmn:startEvent id="start" />
    <bpmn:serviceTask id="review">
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:loopDataInputRef>input_data</bpmn:loopDataInputRef>
        <bpmn:inputDataItem id="input_item" />
        <bpmn:loopDataOutputRef>output_data</bpmn:loopDataOutputRef>
        <bpmn:outputDataItem id="output_item" />
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" />
    <bpmn:sequenceFlow id="flow_start_review" sourceRef="start" targetRef="review" />
    <bpmn:sequenceFlow id="flow_review_end" sourceRef="review" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
